# Esquema Completo: Archivo Único C++ (Header y CPP juntos)

Este bloque unifica el contenido para una referencia rápida de cómo se estructuran ambos archivos en tu proyecto de Unreal Engine.

```cpp
// ==========================================
// 1. ARCHIVO DE CABECERA (UI_Gameplay.h)
// ==========================================

#pragma once

#include "CoreMinimal.h"
#include "GameFramework/Actor.h"
#include "UI_Gameplay.generated.h" // Obligatorio: debe ser el último include del .h

UCLASS()
class ASYLUM_LEARN_API AUI_Gameplay : public AActor
{
    GENERATED_BODY()
    
public: 
    AUI_Gameplay();
    virtual void BeginPlay() override;

    // Expone la variable en el editor para asignar el WBP_HUD
    UPROPERTY(EditAnywhere, Category = "UI")
    TSubclassOf<class UUserWidget> ClaseHUD;
};


// ==========================================
// 2. ARCHIVO DE IMPLEMENTACIÓN (UI_Gameplay.cpp)
// ==========================================

#include "UI_Gameplay.h"
#include "Blueprint/UserWidget.h" // Obligatorio para usar CreateWidget y AddToViewport

AUI_Gameplay::AUI_Gameplay()
{
    // Desactivamos el Tick para optimizar, ya que solo necesitamos inicializar la UI al arrancar
    PrimaryActorTick.bCanEverTick = false;
}

void AUI_Gameplay::BeginPlay()
{
    Super::BeginPlay();

    // 1. Comprobamos que la clase del HUD esté asignada en el editor
    if (ClaseHUD)
    {
        // 2. Creamos la instancia del Widget
        UUserWidget* HUDInstancia = CreateWidget<UUserWidget>(GetWorld(), ClaseHUD);

        // 3. Si se creó con éxito, lo mostramos en la pantalla del jugador
        if (HUDInstancia)
        {
            HUDInstancia->AddToViewport();
        }
    }
}
